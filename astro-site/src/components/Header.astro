---
// Site header / navigation.
// Pass `active` ("home" | "projects" | "blog" | "about") to highlight the current page.
const { active = "" } = Astro.props;
const links = [
  { href: "/", label: "Home", key: "home" },
  { href: "/projects", label: "Projects", key: "projects" },
  { href: "/blog", label: "Blog", key: "blog" },
  { href: "/cv", label: "CV", key: "cv" },
  { href: "/about", label: "About", key: "about" },
];
---

<header class="nav">
  <div class="nav-in">
    <a class="brand" href="/">
      <span class="brand-mark">NA</span>
      <span class="brand-name">Ngwashi Anthony<span> / mechatronics</span></span>
    </a>
    <nav class="nav-links">
      {links.map((l) => (
        <a href={l.href} class={active === l.key ? "active" : ""}>{l.label}</a>
      ))}
    </nav>
    <button class="hamburger" id="menu-toggle" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer">
  <nav class="drawer-links">
    {links.map((l) => (
      <a href={l.href} class={active === l.key ? "active" : ""}>{l.label}</a>
    ))}
  </nav>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("mobile-drawer");
  toggle?.addEventListener("click", () => {
    drawer?.classList.toggle("open");
    toggle.classList.toggle("open");
  });
  drawer?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") {
      drawer.classList.remove("open");
      toggle?.classList.remove("open");
    }
  });
</script>
