---
// The shell every page shares: <head>, fonts, global CSS, header + footer.
// Usage:  <BaseLayout title="Projects" active="projects"> ...page... </BaseLayout>
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = "Ngwashi Anthony · Mechatronics Student",
  description = "Mechatronics student building robots, PCBs, and software. Portfolio of projects in robotics, embedded systems, and control.",
  image = "/images/hero-3d.png",
  active = "",
} = Astro.props;

// Canonical/OG URLs come from `site` in astro.config.mjs — one place to change the domain.
const site = Astro.site ?? new URL("https://madarakante.github.io");
const canonicalURL = new URL(Astro.url.pathname, site).href;
const imageURL = image.startsWith("http") ? image : new URL(image, site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Ngwashi Anthony · Mechatronics Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header active={active} />
    <slot />
    <Footer />

    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Zoomed image">
      <img id="lightbox-img" alt="" />
      <span class="lightbox-hint">click image for 100% · click outside or press esc to close</span>
    </div>

    <script>
      // Site-wide image zoom: click any image to open it, click the image again
      // for 100% pixels, click the backdrop (or Esc) to close.
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;

      const open = (img: HTMLImageElement) => {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt || "";
        lightbox.classList.add("open");
        lightbox.classList.remove("actual");
        lightbox.scrollTop = 0;
        lightbox.scrollLeft = 0;
        document.body.classList.add("lb-open");
      };

      const close = () => {
        lightbox?.classList.remove("open", "actual");
        document.body.classList.remove("lb-open");
      };

      document.addEventListener("click", (e) => {
        if (!lightbox || !lightboxImg) return;
        const target = e.target as HTMLElement | null;
        if (!target) return;

        if (lightbox.contains(target)) {
          if (target === lightboxImg) {
            lightbox.classList.toggle("actual");
            lightbox.scrollTop = 0;
            lightbox.scrollLeft = 0;
          } else {
            close();
          }
          return;
        }

        const img = target.closest("img") as HTMLImageElement | null;
        if (!img) return;
        // Stop the click from also following the card/post link it sits in.
        e.preventDefault();
        e.stopPropagation();
        open(img);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    </script>
  </body>
</html>
