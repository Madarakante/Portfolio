---
import BaseLayout from '../layouts/BaseLayout.astro';

const nav = [
  { href: '#overview', label: 'Overview' },
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#products', label: 'Products' },
  { href: '#request', label: 'Request' },
];

const specs = [
  { k: 'On request', v: 'Custom components and assemblies, built to spec.' },
  { k: 'In-house', v: 'Design, prototyping and small-batch production.' },
  { k: 'Local', v: 'Designed and built in-country, Douala, CM.' },
];

const buildTypes = ['PCB / board', 'Sensor module', 'Power unit', 'Assembly'];

const capabilities = [
  {
    idx: '01.1',
    title: 'Custom components',
    body: 'Sensors, boards, power units and assemblies built to your exact spec, not an off-the-shelf catalog.',
    meta: 'Per brief',
  },
  {
    idx: '01.2',
    title: 'Prototyping',
    body: 'Fast iteration on real hardware. A working board you can test and validate before committing to volume.',
    meta: 'Days, not weeks',
  },
  {
    idx: '01.3',
    title: 'Small-batch production',
    body: 'Once it works, we make more. Reliable short runs, assembled and tested locally, documented per unit.',
    meta: 'Tested + documented',
  },
];

const steps = [
  { t: 'Share your requirements', d: 'Type, quantity, specs, reference files.' },
  { t: 'We assess and quote', d: 'Feasibility and an estimate, usually within days.' },
  { t: 'We build it', d: 'Prototype first, then batch when ready.' },
];

const facts = [
  { ft: 'Local and fast', fd: 'In your timezone, no overseas lead times.' },
  { ft: 'Engineering-first', fd: 'Specs, documentation and testing per unit.' },
  { ft: 'Made for here', fd: 'Designed around local operating conditions.' },
  { ft: 'A first, not a copy', fd: "Cameroon's own hardware capability, from the ground up." },
];
---

<BaseLayout>
  <a href="#overview" class="skip-link">Skip to content</a>

  <header class="masthead">
    <a href="#overview" class="wordmark"><span class="mk" aria-hidden="true"></span>BITSAURA</a>
    <nav class="topnav" aria-label="Sections">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="mast-cta"><a href="#request" class="btn-req">Request a build</a></div>
  </header>

  <div class="sheet">
    <span class="crop tl" aria-hidden="true"></span>
    <span class="crop tr" aria-hidden="true"></span>
    <span class="crop bl" aria-hidden="true"></span>
    <span class="crop br" aria-hidden="true"></span>

    <main id="overview">
      <!-- §00 OVERVIEW -->
      <section class="section">
        <div class="sec-tag"><span class="num">§ 00</span> Overview &mdash; Bitsaura hardware, Rev 03</div>
        <div class="hero-grid">
          <div>
            <h1 class="title">Custom electronics, engineered in <span class="acc">Cameroon</span>.</h1>
            <p class="lead">
              We design and build custom electronic components on request, from a single
              prototype to small-batch production, and we are developing our own hardware
              line in-house.
            </p>
            <div class="specs">
              {
                specs.map((s) => (
                  <div class="spec">
                    <div class="k">{s.k}</div>
                    <div class="v">{s.v}</div>
                  </div>
                ))
              }
            </div>
          </div>

          <figure class="figure">
            <svg viewBox="0 0 420 300" role="img" aria-label="Representative printed circuit board layout drawing">
              <!-- top dimension line -->
              <line class="sx-dim" x1="22" y1="16" x2="398" y2="16" />
              <line class="sx-dim" x1="22" y1="11" x2="22" y2="21" />
              <line class="sx-dim" x1="398" y1="11" x2="398" y2="21" />
              <rect x="186" y="8" width="48" height="14" class="sx-fill" />
              <text x="210" y="18" text-anchor="middle" class="sx-label">120.0</text>

              <!-- board outline + mounting holes -->
              <rect x="22" y="30" width="376" height="226" rx="7" class="sx-line" />
              <circle cx="42" cy="50" r="5" class="sx-line sx-fill" />
              <circle cx="378" cy="50" r="5" class="sx-line sx-fill" />
              <circle cx="42" cy="236" r="5" class="sx-line sx-fill" />
              <circle cx="378" cy="236" r="5" class="sx-line sx-fill" />

              <!-- central IC (U1) -->
              <rect x="158" y="108" width="104" height="84" rx="3" class="sx-line sx-fill" />
              <circle cx="170" cy="120" r="3" class="sx-fill-acc" />
              <text x="210" y="156" text-anchor="middle" class="sx-label-ink">U1</text>
              <!-- IC pins -->
              <line class="sx-line" x1="158" y1="126" x2="146" y2="126" />
              <line class="sx-line" x1="158" y1="143" x2="146" y2="143" />
              <line class="sx-line" x1="158" y1="160" x2="146" y2="160" />
              <line class="sx-line" x1="158" y1="177" x2="146" y2="177" />
              <line class="sx-line" x1="262" y1="126" x2="274" y2="126" />
              <line class="sx-line" x1="262" y1="143" x2="274" y2="143" />
              <line class="sx-line" x1="262" y1="160" x2="274" y2="160" />
              <line class="sx-line" x1="262" y1="177" x2="274" y2="177" />

              <!-- R1 footprint -->
              <rect x="70" y="118" width="13" height="18" class="sx-line sx-fill" />
              <rect x="70" y="150" width="13" height="18" class="sx-line sx-fill" />
              <line class="sx-line" x1="76" y1="136" x2="76" y2="150" />
              <text x="58" y="116" class="sx-label">R1</text>

              <!-- C1 footprint -->
              <rect x="312" y="150" width="18" height="12" class="sx-line sx-fill" />
              <rect x="338" y="150" width="18" height="12" class="sx-line sx-fill" />
              <line class="sx-line" x1="330" y1="156" x2="338" y2="156" />
              <text x="312" y="144" class="sx-label">C1</text>

              <!-- traces -->
              <polyline class="sx-thin" points="146,143 110,143 110,127 76,127 76,136" />
              <polyline class="sx-thin" points="274,160 300,160 300,156 312,156" />
              <polyline class="sx-thin" points="274,177 296,177 296,210 150,210" />

              <!-- highlighted net -->
              <polyline class="sx-acc" points="146,126 100,126 100,90 210,90 210,108" />
              <circle cx="100" cy="126" r="3.4" class="sx-fill-acc" />
              <circle cx="210" cy="90" r="2.6" class="sx-fill-acc" />

              <!-- left dimension tick -->
              <line class="sx-dim" x1="12" y1="30" x2="12" y2="256" />
              <line class="sx-dim" x1="7" y1="30" x2="17" y2="30" />
              <line class="sx-dim" x1="7" y1="256" x2="17" y2="256" />
            </svg>
            <figcaption class="figcap"><span>Fig. 1 &mdash; Representative board</span><span>NTS</span></figcaption>
          </figure>
        </div>

        <!-- build request form -->
        <form class="form" id="build" onsubmit="return false">
          <div class="form-head"><span>Build request &mdash; what are you making?</span><span class="rev">FORM-01</span></div>
          <div class="form-body">
            <div class="field-label">Select build type</div>
            <div class="opts" role="radiogroup" aria-label="Build type">
              {
                buildTypes.map((t, i) => (
                  <button
                    type="button"
                    class={`opt${i === 0 ? ' is-active' : ''}`}
                    role="radio"
                    aria-checked={i === 0 ? 'true' : 'false'}
                    data-value={t}
                  >
                    <span class="box" aria-hidden="true"></span>{t}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="form-foot">
            <span class="selected-note">SELECTED: PCB / BOARD</span>
            <a href="#request" class="btn-ink form-continue">Continue with PCB / board →</a>
          </div>
        </form>
      </section>

      <!-- §01 CAPABILITIES -->
      <section id="capabilities" class="section">
        <div class="sec-tag"><span class="num">§ 01</span> Capabilities &mdash; from sketch to hardware</div>
        <div class="spec-list">
          {
            capabilities.map((c) => (
              <div class="spec-row">
                <div class="idx">{c.idx}</div>
                <div>
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </div>
                <div class="meta">{c.meta}</div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- §02 PRODUCT LINE -->
      <section id="products" class="section">
        <div class="sec-tag"><span class="num">§ 02</span> Product line &mdash; in development</div>
        <div class="products-head">
          <h2>Hardware we are building, in the open.</h2>
          <span class="stamp">Preliminary</span>
        </div>
        <p class="sr-only" role="status">
          Product specifications are being finalized and will be published here soon.
        </p>
        <div class="table-wrap">
          <table class="ptable">
            <thead>
              <tr>
                <th scope="col">Ref</th>
                <th scope="col">Description</th>
                <th scope="col">Phase</th>
                <th scope="col">Completion</th>
              </tr>
            </thead>
            <tbody aria-hidden="true">
              {
                ['AURA-01', 'AURA-02', 'AURA-03'].map((ref, i) => (
                  <tr>
                    <td class="ref">{ref}</td>
                    <td>
                      <span class="skeleton sk-line" style={`width:${[78, 64, 84][i]}%`}></span>
                    </td>
                    <td>
                      <span class="skeleton sk-line" style="width:74px"></span>
                    </td>
                    <td>
                      <span class="skeleton sk-bar" style="width:88px"></span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="products-note">
          <span class="products-note-dot" aria-hidden="true"></span>
          Specifications withheld pending release. Detailed datasheets are in preparation.
        </p>
      </section>

      <!-- §03 REQUEST + ABOUT -->
      <section id="request" class="section">
        <div class="sec-tag"><span class="num">§ 03</span> Request a build &amp; why Bitsaura</div>
        <div class="split">
          <div>
            <h2 class="block-title">Tell us what you need built.</h2>
            <p class="block-lead">
              Send the brief: a spec, a sketch, even a rough idea. We reply with feasibility,
              an approach and an estimate.
            </p>
            <div class="steps">
              {
                steps.map((s, i) => (
                  <div class="step">
                    <div class="n" aria-hidden="true">{`0${i + 1}`}</div>
                    <div>
                      <div class="t">{s.t}</div>
                      <div class="d">{s.d}</div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div>
            <h2 class="block-title">Building the hardware capability Cameroon had to import.</h2>
            <p class="block-lead">
              No more shipping a brief overseas and waiting weeks. Design, prototyping and
              production, all done here.
            </p>
            <div class="facts">
              {
                facts.map((f) => (
                  <div class="fact">
                    <div class="ft">{f.ft}</div>
                    <div class="fd">{f.fd}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- title block / footer -->
      <section class="section" style="padding-bottom:0">
        <div class="titleblock">
          <div class="tb-cell">
            <div class="k">Project</div>
            <div class="v brand">BITSAURA HARDWARE</div>
          </div>
          <div class="tb-cell">
            <div class="k">Location</div>
            <div class="v">Douala, CM</div>
          </div>
          <div class="tb-cell">
            <div class="k">Status</div>
            <div class="v"><span class="tb-status"><span class="dot" aria-hidden="true"></span>Open Q3 2026</span></div>
          </div>
          <div class="tb-cell">
            <div class="k">Revision</div>
            <div class="v">03</div>
          </div>
          <div class="tb-cell">
            <div class="k">Contact</div>
            <div class="v"><a href="mailto:hello@bitsaura.cm">hello@bitsaura.cm</a></div>
          </div>
          <div class="tb-cell">
            <div class="k">Drawn</div>
            <div class="v">In-house</div>
          </div>
          <div class="tb-cell">
            <div class="k">Sheet</div>
            <div class="v">1 / 1</div>
          </div>
          <div class="tb-cell">
            <div class="k">Issued</div>
            <div class="v">© 2026</div>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  // Build-type selector: single-select radio group with field-style indicators.
  const opts = Array.from(document.querySelectorAll<HTMLButtonElement>('.opt'));
  const note = document.querySelector<HTMLElement>('.selected-note');
  const cont = document.querySelector<HTMLAnchorElement>('.form-continue');
  const select = (chosen: HTMLButtonElement) => {
    opts.forEach((o) => {
      o.classList.toggle('is-active', o === chosen);
      o.setAttribute('aria-checked', String(o === chosen));
    });
    const value = chosen.dataset.value ?? '';
    if (note) note.textContent = `SELECTED: ${value.toUpperCase()}`;
    if (cont) cont.textContent = `Continue with ${value} →`;
  };
  opts.forEach((o) => o.addEventListener('click', () => select(o)));

  // Highlight the section currently in view in the top nav.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.topnav a'));
  const byId = new Map(links.map((l) => [l.getAttribute('href')!.slice(1), l]));
  const sections = Array.from(document.querySelectorAll('main section[id]'));
  if ('IntersectionObserver' in window && sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('is-active'));
            byId.get(e.target.id)?.classList.add('is-active');
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
